# Every variable below is one this codebase actually reads. Generated by
# grepping `process.env.*` across server/src, so it should not drift.
# Anything left blank is optional — the feature that needs it degrades with a
# clear message rather than crashing.

# ─── Core ────────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/crmitdesk
JWT_SECRET=change-me-to-something-long-and-random
JWT_EXPIRES_IN=15m
# Encrypts OAuth refresh tokens, mail passwords and the employee bank/tax
# columns before they reach the database. REQUIRED. 32+ random characters.
ENCRYPTION_KEY=change-me-32-plus-random-characters
NODE_ENV=production
PORT=4000

# The backend's OWN public URL. Used to build links back to this API — the
# Google OAuth redirect URI and CSAT survey links. Must be internet-reachable
# in production, not localhost. On the AWS/nginx setup: https://<your-domain>
APP_URL=https://crm.example.com
# Where users' browsers live — OAuth sends them back here after consent.
FRONTEND_URL=https://crm.example.com
CORS_ORIGIN=https://crm.example.com

# ─── Attachment storage ──────────────────────────────────────────────────────
# Full walkthrough: STORAGE-SETUP.md at the repo root.
#
# Google Drive — bring-your-own. Each CLIENT ORG connects their own Google
# account from Settings → Integrations → Storage; these two variables only
# enable that button. Without them it is disabled with an explanatory message.
#
# One OAuth client (Google Cloud project owned by zenkaratech@gmail.com) covers
# Sign-In, Drive and Calendar. Authorised redirect URIs to register — must
# match byte for byte:
#   ${APP_URL}/api/storage/google/callback
#   ${APP_URL}/api/calendar/callback
# Also set the same Client ID as VITE_GOOGLE_CLIENT_ID in the client build
# (GitHub repo variable GOOGLE_CLIENT_ID for deploy.yml).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Hosted storage — ONE bucket you own, shared by every org, objects namespaced
# by orgId. Offered only to orgs whose plan carries a quota
# (Free 0GB / Pro 5GB / Enterprise 50GB).
#
# These are a FALLBACK. A PLATFORM_ADMIN can set the same values in the console
# (Platform Admin → Platform settings → Hosted attachment storage), which wins
# per field and takes effect with no redeploy. Leave a console field blank to
# keep using the env var below.
#
# Nothing here is needed for customers who bring their OWN S3 bucket — that
# path requires no deployment configuration at all.
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
# Omit for real AWS S3; set it for R2 / MinIO / other S3-compatible gateways.
S3_ENDPOINT=

# ─── AI ──────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
GROQ_API_KEY=
# Per-1K-token pricing, used to cost interactions in the AI governance ledger.
OPENAI_INPUT_COST_PER_1K=
OPENAI_OUTPUT_COST_PER_1K=
GROQ_INPUT_COST_PER_1K=
GROQ_OUTPUT_COST_PER_1K=
# Hard ceiling on a single model call. Defaults to 30000 (30s).
AI_REQUEST_TIMEOUT_MS=30000
# Model overrides. Providers retire models on their own schedule (Groq
# decommissioned llama-3.1-8b-instant and llama-3.3-70b-versatile on
# 2026-08-16 and broke every AI feature until the defaults were updated) —
# when that happens again, set the replacement model IDs here and restart;
# no code change needed. Defaults: openai/gpt-oss-20b / openai/gpt-oss-120b
# on Groq, gpt-4o-mini / gpt-4o on OpenAI.
AI_MODEL_FAST=
AI_MODEL_SMART=

# ─── Billing (Stripe) ────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_ENTERPRISE_PRICE_ID=
# Licensing — custom licence pricing (see server/src/utils/pricing.ts)
LICENSE_BASE_SEAT_PRICE_CENTS=800     # platform base per seat/month, in cents
LICENSE_CUSTOM_STORAGE_GB=10          # hosted storage included with the hosted_storage module
LICENSE_YEARLY_MONTHS_CHARGED=10      # yearly billing = 12 months for the price of N
LICENSE_GRACE_PERIOD_DAYS=7           # paid access continues this long after a failed payment

# ─── Email ───────────────────────────────────────────────────────────────────
# Gmail: SMTP_PASS must be a 16-char App Password (Google Account → Security →
# 2-Step Verification → App passwords), not the normal account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=zenkaratech@gmail.com
SMTP_PASS=
SMTP_FROM=Zenkara 360 <zenkaratech@gmail.com>
# Alternative to SMTP.
RESEND_API_KEY=
RESEND_FROM=
ADMIN_NOTIFY_EMAIL=zenkara360superadmin@gmail.com

# ─── WhatsApp (Twilio) ───────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ─── Web push ────────────────────────────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:zenkaratech@gmail.com

# ─── Shared secrets for unauthenticated endpoints ────────────────────────────
# Each guards a route that has no logged-in user to authenticate.
QUOTE_SHARE_SECRET=          # signs public quote-view links
WORKFLOW_WEBHOOK_SECRET=     # fallback signing key for outbound webhooks
DIRECTORY_SYNC_SECRET=       # SCIM / directory sync push endpoint
DEMO_RESET_SECRET=           # lets the demo org be reseeded without a shell
PLATFORM_BOOTSTRAP_SECRET=   # creates the first PLATFORM_ADMIN

# ─── Demo ────────────────────────────────────────────────────────────────────
DEMO_LOGIN_EMAIL=
# Logins created by `npm run db:seed`. Leave blank and the seed uses the
# PUBLISHED defaults (admin@crmitdesk.com … / Admin@123) — never on a real
# server. The 7 non-default demo companies get the company added as a
# plus-tag (you+meridian-health@gmail.com). Quote the password if it has # or $.
SEED_ADMIN_EMAIL=
SEED_CRM_EMAIL=
SEED_SALES_EMAIL=
SEED_ITMANAGER_EMAIL=
SEED_ITAGENT_EMAIL=
SEED_PASSWORD=
